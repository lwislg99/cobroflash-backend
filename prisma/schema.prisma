generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Merchant {
  id Int @id @default(autoincrement())

  name      String
  email     String? @unique
  legalName String? @map("legal_name")
  taxId     String? @map("tax_id")
  address   String? @map("address")
  trade     String? @map("trade") // electricista|fontanero|reformista|pintor|cerrajero|climatizacion|otro

  defaultCurrency            String    @default("EUR") @map("default_currency")
  invoiceSeriesPrefix        String    @default("CF") @map("invoice_series_prefix")
  nextInvoiceNumber          Int       @default(1) @map("next_invoice_number")
  invoiceSeriesYear          Int?      @map("invoice_series_year") // año de la serie en curso; al cambiar de año el contador vuelve a 1 (serie anual: 2026-CF-001)
  nextRectInvoiceNumber      Int       @default(1) @map("next_rect_invoice_number") // contador de la serie de rectificativas (2026-CF-R-001), también se resetea por año
  nextQuoteNumber            Int       @default(1) @map("next_quote_number") // A1.2: contador de presupuestos por merchant (sin serie anual: no es doc fiscal)
  // SCRUM-14: serie NO fiscal de albaranes (ALB-YYYY-NNN), independiente de la de
  // facturas; reset anual (mismo patrón que invoiceSeriesYear).
  nextAlbaranNumber          Int       @default(1) @map("next_albaran_number")
  albaranSeriesYear          Int?      @map("albaran_series_year")
  logoUrl                    String?   @map("logo_url")
  whatsappPhone              String?   @map("whatsapp_phone")
  // SCRUM-441 (E2) · el programa del asesor. SON DOS Y NO UNA: con solo la respuesta, `null`
  // significaria a la vez "no se le pregunto" y "se le pregunto y paso" — el mismo valor con dos
  // sentidos opuestos. La fecha dice SI se pregunto; el texto, QUE contesto.
  asesorProgramaPreguntadoAt DateTime? @map("asesor_programa_preguntado_at")
  asesorPrograma             String?   @map("asesor_programa")
  // SCRUM-294 (fase C) · esta el negocio acogido al criterio de caja (RECC)? TRES estados
  // nativos y sin `@default`: NULL = no consta (nadie lo pregunto) · false = declara que no ·
  // true = si. Colapsarlos haria que «no se pregunto» se leyera como «declara que no».
  criterioCaja               Boolean?  @map("criterio_caja")
  googleReviewUrl            String?   @map("google_review_url")

  // CONNECT-1 (C1-0): cuenta Stripe Connect Express del merchant. El estado lo
  // gobierna el webhook account.updated según charges_enabled (D3 del master).
  stripeAccountId    String? @map("stripe_account_id")
  connectStatus      String  @default("none") @map("connect_status") // none|pending|active|restricted
  // C1-4: móvil para Bizum manual asistido (default en UI: whatsappPhone, editable)
  bizumPhone         String? @map("bizum_phone")
  // A10.2 (EXT3, Parte L): estado de la suscripción de Stripe — ok|past_due|canceled.
  // plan conserva QUÉ plan es; esto conserva CÓMO está (banner past_due + portal).
  subscriptionStatus String? @map("subscription_status") // active | past_due | canceled

  // A14 (EXT3, PERFIL-1): perfil público /p/:slug · flag PUBLIC_PROFILE_ENABLED (OFF)
  slug          String?   @unique
  slugChangedAt DateTime? @map("slug_changed_at") // editable 1 vez/30d
  profileZones  Json?     @map("profile_zones") // chips de zonas
  profileYears  Int?      @map("profile_years") // años de experiencia (opc.)

  // Parte P: overrides de flags POR MERCHANT (precedencia merchant > país > env).
  // La lee core/flags.ts; nace para los opt-in PERFIL-1/MANT-1. {FLAG_NAME: bool}
  flags Json? @map("flags")

  // A6.7: preferencias de la Home (bloques visibles) — {hero,quick,kpis,week,activity,tops}: bool
  homePrefs Json? @map("home_prefs")

  // SCRUM-102: segundo factor para el gate "owner" (isVerifiedPlatformOwner, env.ts) —
  // dato multi-tenant sensible (fees.csv, platform-funnel) no puede depender SOLO de
  // que OWNER_EMAILS esté bien escrita en Railway (precedente: SCRUM-99, un secreto de
  // webhook faltó en prod sin que nadie lo supiera). default false: requiere UPDATE
  // manual explícito en el merchant del fundador tras el db push — deliberado, un
  // flag de BD no se activa "por accidente" como sí puede pasar con una env var.
  isPlatformOwner Boolean @default(false) @map("is_platform_owner")

  // Auth / plan
  onboardingCompleted  Boolean   @default(false) @map("onboarding_completed")
  plan                 String    @default("trial") // trial | basic | pro | empresa
  planExpiresAt        DateTime? @map("plan_expires_at")
  stripeCustomerId     String?   @map("stripe_customer_id")
  stripeSubscriptionId String?   @map("stripe_subscription_id")

  country String

  // SCRUM-643 · EL HUSO HORARIO CON EL QUE SE CALCULA EL CALENDARIO DE ESTE MERCHANT.
  //
  // Nace de un defecto MEDIDO: tres cálculos fiscales —el mes natural del art. 13, el semáforo
  // del plazo del art. 13.2 y el corte «hasta el día X»— usaban el reloj LOCAL DEL SERVIDOR, y
  // el servidor va en UTC (Railway, sin variable TZ) mientras la península va en UTC+1/+2. Un
  // albarán del día 1 a las 00:30 hora española caía en la recapitulativa del mes ANTERIOR.
  //
  // 🔴 NO SE DERIVA DE `country`, y está medido: dos merchants del MISMO país pueden estar en
  // husos distintos —península y Canarias en ES, CDMX y Tijuana en MX, continental e Isla de
  // Pascua en CL—. Derivarlo del país sería repetir el error de suponer que «local» es un solo
  // sitio, un escalón más abajo.
  //
  // NULLABLE Y SIN `@default`, como `Customer.contactKind` (CONT-01): NULL = «no declarado»,
  // que es distinto de declarado. Un `@default('Europe/Madrid')` daría por dicho algo que nadie
  // ha dicho, y además fijaría la app a la península — justo lo que la opción A descarta.
  // Quien lo resuelve es `core/zonaDelMerchant.ts`, y NULL cae a UTC (lo de antes de existir
  // esta columna), nunca a Madrid.
  //
  // ⚠️ NO confundir con `profileZones` (chips geográficos del perfil público) ni con el RÉGIMEN
  // fiscal (IVA / IGIC canario / IPSI de Ceuta y Melilla), que es otro dato y es SCRUM-646.
  timezone String? @map("timezone")

  pspId  String? @map("psp_id")
  iban   String?
  clabe  String?
  status String  @default("active")

  // V0-3: atribución de adquisición capturada en el registro (UTM "source/medium/campaign"
  // o "ref:CODIGO" del programa de referidos; null = orgánico/desconocido)
  acquisitionSource String? @map("acquisition_source")

  // Preferencias de notificaciones por email
  notifyEmailOnPaid          Boolean @default(true) @map("notify_email_on_paid")
  notifyEmailOnQuoteAccepted Boolean @default(false) @map("notify_email_on_quote_accepted")
  notifyEmailWeeklyDigest    Boolean @default(false) @map("notify_email_weekly_digest")

  // Lifecycle emails ya enviados, ej: { "welcome": 1, "day3": 1 } — evita duplicados
  lifecycleEmailsSent Json? @map("lifecycle_emails_sent")

  // Sistema de referidos
  referralCode       String?   @unique @map("referral_code")
  referredBy         Int?      @map("referred_by")
  freeMonthsEarned   Int       @default(0) @map("free_months_earned")
  referralRewardedAt DateTime? @map("referral_rewarded_at")

  // Enterprise: branding custom + workflow de aprobación
  brandColor        String?  @map("brand_color") // hex, ej "#1a56db"
  brandAccentColor  String?  @map("brand_accent_color")
  approvalThreshold Decimal? @map("approval_threshold") @db.Decimal(12, 2) // null = sin aprobación

  charges       Charge[]
  Quote         Quote[]
  Invoice       Invoice[]
  Product       Product[]
  Provider      Provider[]
  Customer      Customer[]
  AuthSession   AuthSession[]
  Expense       Expense[]
  TeamMember    TeamMember[]
  QuoteTemplate QuoteTemplate[]
  QuoteRequest  QuoteRequest[]
  CustomerEvent CustomerEvent[]

  // SCRUM-293 (A2) · RETENCIÓN DE IRPF. Autorización expresa del fundador para ESTAS DOS LÍNEAS.
  //
  // DOS columnas y no una, porque hay TRES estados que no pueden colapsar:
  //   declarada=false, tipo NULL  → NO CONSTA: no lo ha dicho todavía
  //   declarada=true,  tipo NULL  → DECLARA QUE NO RETIENE
  //   declarada=true,  tipo=7|15|19 → RETIENE, y a ese porcentaje
  // Con un solo campo anulable, «no lo ha dicho» y «dice que no» serían el mismo valor — y ése es
  // exactamente el defecto que `retencionIrpf.ts` existe para impedir: emitir sin la retención de
  // quien SÍ retiene es un fallo fiscal MUDO. La factura sale, el cliente la paga, y el descuadre
  // aparece meses después en el 111.
  //
  // ⚠️ Las columnas YA EXISTEN en producción y staging (verificado por `information_schema`), así
  // que esto NO abre deriva: el esquema alcanza a las bases, no al revés.
  retencionIrpfDeclarada Boolean @default(false) @map("retencion_irpf_declarada")
  retencionIrpfTipo      Int?    @map("retencion_irpf_tipo")

  // SCRUM-656 (T7) · Las clausulas de cierre, escritas UNA vez: [{id, titulo, texto}].
  clausulasPresupuesto Json? @map("clausulas_presupuesto")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([country])
  @@map("merchants")
}

model AuthSession {
  id           Int       @id @default(autoincrement())
  merchantId   Int       @map("merchant_id")
  teamMemberId Int?      @map("team_member_id") // null = propietario (admin implícito)
  token        String    @unique
  type         String    @default("session") // magic_link | session
  expiresAt    DateTime  @map("expires_at")
  usedAt       DateTime? @map("used_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  instaladaPwa Boolean?  @map("instalada_pwa") // el último entorno visto; null = no se pudo saber

  merchant   Merchant    @relation(fields: [merchantId], references: [id])
  teamMember TeamMember? @relation(fields: [teamMemberId], references: [id])

  @@index([token])
  @@index([merchantId])
  @@index([teamMemberId])
  @@map("auth_sessions")
}

model Customer {
  // SCRUM-574 (CONT-01) · FORMA JURÍDICA DEL CONTACTO: `EMPRESA | PERSONA`.
  //
  // 🔴 NO ES `tipoDestinatario`, Y ÉSA ES LA DECISIÓN ENTERA DE ESTE CAMPO. El ticket original
  // mandaba reutilizar aquél («no se añade campo: se promueve el que ya existía»), y esa premisa
  // se cayó al medirla: `tipoDestinatario` es el campo fiscal de SCRUM-69 y fija el plazo legal
  // de la recapitulativa (art. 13.2 RD 1619/2012). Son dos preguntas distintas:
  //
  //   contactKind       → FORMA JURÍDICA. Qué es el contacto. Decide qué campos enseña la ficha.
  //   tipoDestinatario  → CAPACIDAD FISCAL. Si actúa como empresario a efectos de IVA.
  //
  // Un AUTÓNOMO es `PERSONA` aquí y `EMPRESARIO` allí — y es justo el cliente que abrió el
  // ticket (el administrador de fincas). Con un solo campo, ese cliente queda con el plazo legal
  // equivocado y un control de UI pasa a mandar sobre una fecha límite fiscal.
  //
  // ⛔ PROHIBIDO MEZCLARLOS (fundador, 24-ago-2026): ni en la migración, ni en el formulario, ni
  // en un valor por defecto que deduzca uno del otro. Lo que se destapó tiene ticket: SCRUM-615.
  //
  // Nullable y SIN `@default`, por el mismo motivo que sus dos vecinos (`tipoDestinatario` y
  // `recargoEquivalencia`): NULL = «no declarado», distinto de declarado. Un `@default` habría
  // convertido a los 15 clientes existentes en «declarados» sin que nadie lo dijera. String y no
  // enum, como el resto: la lista cerrada vive en Zod y añadir un valor no obliga a migrar un
  // tipo de Postgres.
  contactKind String? @map("contact_kind")

  // A20.4 (EXT3): cliente empresa — razón social y NIF (el NIF además es
  // requisito del F1 VeriFactu futuro, hallazgo S1-C)
  legalName String? @map("legal_name")
  taxId     String? @map("tax_id")

  id          Int     @id @default(autoincrement())
  merchantId  Int     @default(1) @map("merchant_id")
  name        String
  phone       String?
  email       String?
  notes       String?
  portalToken String? @unique @map("portal_token")
  // J3: baja de WhatsApp ("BAJA"/"STOP" o manual desde la ficha) — bloquea TODA
  // plantilla saliente a este número para este merchant. Flag ortogonal (Parte L).
  waOptOut    Boolean @default(false) @map("wa_opt_out")

  // SCRUM-69 (FACT-1): PARTICULAR | EMPRESARIO — determina el plazo legal de la factura
  // recapitulativa (art. 13 RD 1619/2012): fin de mes natural si particular, día 16 del mes
  // siguiente si empresario. SIN @default en la BD a propósito: null = "nunca clasificado",
  // distinto de "clasificado como particular" — el criterio seguro (tratar null como
  // PARTICULAR, el plazo MÁS CORTO) se aplica en código (resolveTipoDestinatario), nunca se
  // escribe de vuelta a la BD. Editable en la ficha del cliente, sin banner ni prompt forzado.
  tipoDestinatario String? @map("tipo_destinatario")

  // SCRUM-294-a (A3) · REGIMEN DE RECARGO DE EQUIVALENCIA DEL CLIENTE.
  //
  // `Boolean?` SIN `@default`, y es la decision entera: un `@default(false)` convertiria a TODOS
  // los clientes de hoy en «declarado que NO lo lleva», y eso no lo ha dicho nadie. Los tres
  // estados son nativos del tipo:
  // NULL  = no consta (todos los clientes existentes)
  // false = el profesional declara que NO
  // true  = el profesional declara que SI
  //
  // La columna `recargo_equivalencia` YA EXISTE en produccion y staging (verificado por
  // information_schema): esto es el esquema poniendose al dia, no una migracion.
  //
  // 🛑 NO ESTA CABLEADA AL TOTAL, y no es un olvido: el recargo cambia lo que el cliente paga
  // —base + cuota + recargo— y por tanto el numero que se SELLA. Eso es camino de emision
  // (regla 38) y no entra con este dato. El calculo existe y espera en
  // `invoicing/domain/recargoEquivalencia.ts`.
  recargoEquivalencia Boolean? @map("recargo_equivalencia")

  /// SCRUM-171b (FACT-2d): periodicidad PACTADA de facturación — `NINGUNA | QUINCENAL | MENSUAL`.
  ///
  /// SIRVE PARA AVISAR, NO PARA FACTURAR SOLO. Decisión del fundador (27-jul-2026): un cron que
  /// factura por su cuenta es exactamente lo que un profesional NO quiere la primera vez que usa
  /// esto; que le avise y decida él es mejor producto. Además, un envío automático nuevo tendría
  /// que pasar por la tabla J6 del máster (regla 28) — avisando, esa regla no se toca.
  ///
  /// El plazo legal manda por encima: la bandeja de SCRUM-69 ya calcula la fecha límite del
  /// art. 13.2 RD 1619/2012 según `tipoDestinatario`, y una periodicidad genérica NUNCA puede
  /// saltárselo. La periodicidad dice CADA CUÁNTO tocaría; el plazo dice cuándo es tarde.
  ///
  /// `NINGUNA` por defecto = el comportamiento de hoy, intacto (sin aviso). String y no enum,
  /// igual que `tipoDestinatario` y `modoValoracion`: la lista vive en el código con su
  /// validación, y añadir un valor no obliga a migrar un tipo de Postgres.
  billingPeriodicity String @default("NINGUNA") @map("billing_periodicity")

  // SCRUM-579 (CONT-06) · LA DIRECCION DE FACTURACION DEL CLIENTE. UNA, no dos.
  //
  // El prefijo `billing` no es decoracion: es lo que impide que alguien confunda esto con la
  // direccion de la OBRA. El fundador cerro la P2 el 24-ago-2026: la direccion de obra pertenece
  // al DOCUMENTO y no al cliente, porque un cliente puede tener tres obras. Eso es DOC-12.
  //
  // NULLABLE Y SIN @default, LOS CINCO — incluido el pais. Es el mismo motivo escrito en
  // `contactKind`, `tipoDestinatario` y `recargoEquivalencia`: NULL = «no declarado», que es
  // distinto de declarado. «Espana por defecto» es del FORMULARIO (el selector nace en ES), no de
  // la columna: un @default("ES") convertiria a los clientes que ya existen en «declarados en
  // Espana» sin que nadie lo haya dicho, y ademas haria indistinguible «no tiene direccion» de
  // «tiene la direccion en blanco».
  billingAddress    String? @map("billing_address")
  billingCity       String? @map("billing_city")
  billingPostalCode String? @map("billing_postal_code")
  billingProvince   String? @map("billing_province")
  billingCountry    String? @map("billing_country")

  merchant     Merchant        @relation(fields: [merchantId], references: [id])
  charges      Charge[]
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  Quote        Quote[]
  Invoice      Invoice[]
  QuoteRequest QuoteRequest[]
  events       CustomerEvent[]

  @@index([merchantId])
  @@map("customers")
}

model Charge {
  id         Int       @id @default(autoincrement())
  merchantId Int       @map("merchant_id")
  customerId Int?      @map("customer_id")
  concept    String    @map("concepto")
  amount     Decimal   @map("importe") @db.Decimal(12, 2)
  currency   String    @map("moneda")
  method     String
  status     String
  expiresAt  DateTime? @map("vencimiento")
  reference  String?   @map("referencia")
  intentId   String?   @map("intent_id")

  // A2.1: métodos habilitados para este cobro (heredados del quote o fijados al
  // crear). null = todos los que el merchant tenga activos. ["card","bizum","transfer"]
  payMethods Json? @map("pay_methods")

  // SCRUM-74: token OPACO del recibo público (patrón Albaran.firmaToken, SCRUM-49;
  // Charge.id es autoincremental y NO debe usarse como identificador público — IDOR/RGPD).
  // Generado perezosamente (crypto.randomBytes(16).hex) la primera vez que se necesita
  // un enlace; @unique para el lookup findUnique por token en /recibo/:token[/pdf|/feedback].
  receiptToken String? @unique @map("receipt_token")

  merchant        Merchant         @relation(fields: [merchantId], references: [id])
  customer        Customer?        @relation(fields: [customerId], references: [id])
  events          Event[]
  reconciliations Reconciliation[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  // SCRUM-397 · CUANDO ENTRO EL EURO, y no cuando se toco la fila. Hasta hoy el cobro no tenia
  // fecha propia: `exportData.ts:248` usaba `updated_at`, que es CUALQUIER modificacion, y
  // `modelo303.ts:236` avisa de que tres de las cinco formas se marcan a mano. Nullable y sin
  // default: los cobros ya existentes no la tienen y ponerles `updated_at` seria inventarla.
  paidAt    DateTime? @map("paid_at")
  Quote     Quote[]
  invoices  Invoice[]

  @@index([merchantId, status])
  @@index([customerId])
  @@index([status, expiresAt])
  @@map("charges")
}

model Event {
  id       Int      @id @default(autoincrement())
  chargeId Int      @map("charge_id")
  type     String
  payload  Json?
  ts       DateTime @default(now())

  charge Charge @relation(fields: [chargeId], references: [id])

  @@index([chargeId, type])
  @@map("events")
}

model Reconciliation {
  id       Int      @id @default(autoincrement())
  chargeId Int      @map("charge_id")
  bankRef  String?  @map("bank_ref")
  matched  Boolean  @default(false)
  ts       DateTime @default(now())

  charge Charge @relation(fields: [chargeId], references: [id])

  @@index([chargeId, matched])
  @@map("reconciliations")
}

model Quote {
  // SCRUM-195 (mec. 2, PASO 1 · ADITIVO): un Job puede tener VARIOS Quotes — el original y sus
  // presupuestos adicionales. NULLABLE a proposito: un Quote que aun no se ha aceptado no tiene
  // Job (en produccion son 83 de 125). `Job.quoteId @unique` NO se retira aqui: conviven hasta
  // el paso 2, cuando ningun consumidor lo use.
  //
  // SIN FK, y es decision del fundador con tres motivos: (1) coherencia -- ningun merchantId de
  // este schema declara FK (SCRUM-192), meter una aqui crearia una isla con reglas propias;
  // (2) reversibilidad -- sin FK el paso 1 se deshace con un DROP COLUMN limpio; (3) el que
  // manda: la FK que importaria aqui es `onDelete`, y eso ya se decidio en SCRUM-192 (opcion B,
  // servicio de borrado derivado del schema, no cascadas). La integridad Quote.jobId -> Job.id
  // la sostiene el CODIGO, y quien la respeta al borrar es el servicio de SCRUM-192.
  jobId       Int?     @map("job_id")
  // SCRUM-195 · LA MITAD PENDIENTE: `jobId` dice A QUÉ TRABAJO pertenece, pero no SI ES EL
  // ORIGINAL O UN ADICIONAL — un adicional aceptado tiene el mismo `jobId` que el original, así
  // que el rol NO se puede deducir de ahí. `sendQuote.service.ts:31` lo dice literalmente:
  // «Depende del ROL del presupuesto (`Quote.esAdicional`), que es schema del fundador y está
  // PENDIENTE. Deducirlo de otra cosa sería simular el rol.»
  //
  // Nullable y SIN `@default`: los presupuestos anteriores no tienen rol asignado, y `null`
  // («no se sabe») no es `false` («se decidió que es el original»).
  esAdicional Boolean? @map("es_adicional")

  // EXT3: origin (A15: maintenance) · validUntil (A16.2: caducidad, default 30d en código)
  // · docFields (A20.4: qué datos del cliente muestra el documento)
  origin     String? // null|manual … | maintenance
  validUntil DateTime? @map("valid_until")
  docFields  Json?     @map("doc_fields") // {name,phone,taxId,email}: bool

  id         Int @id @default(autoincrement())
  merchantId Int
  customerId Int

  // A1.2: número visible POR MERCHANT (1, 2, 3…). El `id` global queda solo
  // para links/API (/pay/quote/:id): mostraba el autoincrement de toda la
  // plataforma (el primer presupuesto de un merchant nuevo salía "#47").
  // Nullable: quotes anteriores al backfill muestran el id como fallback.
  quoteNumber Int? @map("quote_number")

  // A2.1: métodos de pago habilitados para ESTE presupuesto (selector al crear:
  // ["card","bizum","transfer"]). null = todos los que el merchant tenga activos.
  payMethods Json? @map("pay_methods")

  status            String    @default("draft")
  total             Decimal   @db.Decimal(12, 2)
  currency          String    @db.VarChar(3)
  lines             Json
  acceptedAt        DateTime?
  paymentTerms      String?
  customBillingPlan Json?     @map("custom_billing_plan") // SCRUM-27: [{percentage, label}] plan de tramos personalizado (fracción 0-1; índice = orden)
  // V0-3: telemetría quote_created_via ('text' | 'voice' con VOZ-1)
  createdVia        String?   @map("created_via")
  rejectedAt        DateTime?
  decisionChannel   String?
  decisionComment   String?
  rejectionReason   String?
  pdfUrl            String?   @db.Text
  signatureUrl      String?   @db.Text
  tiers             Json?
  selectedTierId    String?
  internalNotes     String?   @map("internal_notes") @db.Text // Notas privadas del profesional, nunca visibles al cliente
  evidence          Json?
  chargeId          Int?
  reminderSentAt    DateTime?
  teamMemberId      Int?      @map("team_member_id") // técnico que creó la cotización (null = propietario)

  // SCRUM-95: token OPACO para las páginas/acciones públicas del cliente (patrón
  // Charge.receiptToken SCRUM-74, Albaran.firmaToken SCRUM-49). Quote.id es autoincremental
  // y NUNCA debe usarse como identificador público — era la sexta puerta de la misma fuga
  // (SCRUM-72/74/85/87/90), la peor: sin auth, sin rate-limit en /decision, y MUTABA estado
  // (aceptar/rechazar presupuestos ajenos), además de filtrar NIF/dirección/teléfono del
  // profesional. Generado perezosamente (crypto.randomBytes(16).hex) la primera vez que se
  // necesita un enlace; @unique para el lookup findUnique por token.
  decisionToken String? @unique @map("decision_token")

  // SCRUM-655 (T6) · La revision de un presupuesto. `0` = original, `1` = el «P2004226.1».
  // VA APARTE y NO dentro del texto del numero: metido en la cadena, saber que revisiones hay
  // obligaria a PARSEAR UN TEXTO ESCRITO PARA HUMANOS, y el dia que alguien cambie el formato el
  // mecanismo muere en silencio. «Vigente» tampoco es una bandera: es la revision mas alta,
  // derivada — una bandera puede contradecir a los datos (dos vigentes, o ninguna).
  revision Int @default(0)

  // SCRUM-656 (T7) · como presenta el IVA ESTE presupuesto: 'sumar' | 'no_incluido'.
  // NULL = anterior a la casilla → sale como salia. Sin @default: «no consta» y «suma» no son
  // lo mismo, aunque hoy se pinten igual.
  ivaModo            String? @map("iva_modo")
  // Los id de las clausulas del merchant que ESTE presupuesto no lleva. Excluir no es borrar.
  clausulasExcluidas Json?   @map("clausulas_excluidas")

  merchant Merchant @relation(fields: [merchantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  charge   Charge?  @relation(fields: [chargeId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  Invoice   Invoice[]
  Expense   Expense[]

  // SCRUM-195: los adicionales se buscan por Job, SIEMPRE dentro del merchant (regla 2).
  @@index([merchantId, jobId])
  @@map("quotes")
}

model Invoice {
  id         Int  @id @default(autoincrement())
  merchantId Int
  customerId Int
  quoteId    Int?
  chargeId   Int? @map("charge_id")

  number     String
  total      Decimal @db.Decimal(12, 2)
  currency   String  @db.VarChar(3)
  pdfUrl     String
  qrData     String
  registerId String?

  status        String    @default("pending") @map("status")
  paidAt        DateTime? @map("paid_at")
  // SCRUM-441 · CÓMO entró el dinero de una factura marcada A MANO. `Charge` ya lo guarda para lo
  // que pasa por pasarela; esto es para lo que NO pasa —transferencia, efectivo, Bizum confirmado
  // por una persona—, que hasta hoy salía en la pantalla del dinero como «Método no registrado».
  //
  // 🔴 NULLABLE, SIN DEFAULT, Y NUNCA RELLENADO POR COPIA DESDE `Charge.method`: ese campo guardó a
  // la vez la intención (`card`) y el hecho (`card:stripe`), y mirando una fila no se puede saber
  // cuál de las dos es. Copiarlo duplicaría el defecto en vez de moverlo, y de forma irreversible.
  // `NULL` = «no consta», que es la verdad. Lo impide `tests/scrum441-paidvia-sin-copia.test.mjs`.
  //
  // El estilo del nombre no se eligió a ojo: en esta tabla `snake_case` gana 16 a 7 (medido).
  paidVia       String?   @map("paid_via")
  clientComment String?   @map("client_comment")
  stageLabel    String?   @map("stage_label") // SCRUM-27: etiqueta del tramo, congelada al crear la factura

  // Líneas de detalle (copiadas del Quote o del Charge al crear la factura)
  lines Json?

  // SCRUM-500 (A2-c) · SUPLIDOS: lo pagado POR CUENTA del cliente y repercutido tal cual, sin IVA
  // y sin margen — una tasa municipal, el visado de un colegio, una licencia de obra. Poner ahí un
  // material propio es un error FISCAL: el material se compra para uno y se revende con su IVA.
  //
  // UNA columna y no dos (el patrón del recargo, no el de la retención), y el motivo es del TIPO
  // de dato: esto es un IMPORTE, y un importe tiene un cero legítimo, así que los tres estados
  // caben en una sola columna anulable:
  //   NULL  = no consta (todas las facturas anteriores a la casilla)
  //   0.00  = declarado: esta factura no lleva suplidos
  //   > 0   = el importe repercutido
  // La retención necesitó DOS porque su dato era un TIPO y «declaro que no retengo» no tenía
  // representación: colapsaba con «no consta» en el mismo NULL.
  //
  // SIN @default a propósito: un 0.00 por defecto convertiría todas las facturas históricas en
  // «declarado que no hay suplidos», que no lo ha dicho nadie.
  //
  // El estilo del nombre no se eligió a ojo. En esta tabla `snake_case` gana 18 a 13, pero el
  // corte que decide es otro: las 13 en camelCase son las columnas ORIGINALES y las 18 en snake
  // las AÑADIDAS —`paid_via`, `retencion_irpf_*`, `recargo_equivalencia`—. Para una columna NUEVA
  // la convención no está 18-13: está 18-0.
  //
  // ⚠️ La columna YA EXISTE en producción (verificado por `information_schema` el 12-ago-2026:
  // `numeric` 12,2, nullable, sin default): esto es el esquema poniéndose al día, no una
  // migración.
  //
  // 🛑 NO LA ESCRIBE NADIE TODAVÍA, y no es un olvido: rellenarla exige tocar los SIETE
  // `invoice.create` del árbol, que son camino de emisión (regla 38). Su valor sale siempre de
  // `totalSuplidos(lines)` (`invoicing/domain/suplidos.ts`) y nunca de una suma escrita aparte:
  // dos sitios que sepan cuánto suman los suplidos acaban diciendo cosas distintas.
  suplidos    Decimal? @map("suplidos") @db.Decimal(12, 2)
  // SCRUM-17 (FISCAL-2): operaciones agrupadas en una recapitulativa — [{albaranId, numero, fecha}].
  // La factura debe identificar los albaranes origen (art. 6 Reglamento + advertencia TEAC).
  albaranRefs Json?    @map("albaran_refs")
  // SCRUM-16/142 (FISCAL-1a): las facturas que esta FINAL descuenta — [{invoiceId, number,
  // fecha, base, cuota, sinDesglose?}]. Es lo que hace AUDITABLE la compensación: sin esto la
  // final dice un importe menor y no consta contra qué (art. 6.1 RD 1619/2012 exige identificar
  // los documentos previos).
  //
  // `buildFinalInvoice` ya los produce y hoy NO TIENEN DÓNDE IR. Mismo patrón EXACTO que
  // `albaranRefs`: `Json?` en la fila, tipado en `EmitInvoiceInput`. NO se derivan de las líneas
  // negativas — de un concepto en texto no se saca un identificador de factura.
  deductsRefs Json?    @map("deducts_refs")

  // Tipo de factura (RD 1619/2012 / VeriFactu): F1 = completa estándar | R1 = rectificativa
  type        String @default("F1")
  rectifiesId Int?   @map("rectifies_id") // factura original a la que rectifica (solo R1)

  // VeriFactu (Reglamento de Facturación España — RTSF RD 1007/2023)
  //
  // SCRUM-205 · ESTADO DE SELLADO — es el estado de NACIMIENTO, no un caso de error.
  //
  // Entre «número consumido» y «factura sellada» había una ventana en la que la factura
  // existía sin huella y NADA lo decía: si el proceso moría en medio quedaba una factura
  // fantasma, indistinguible de una correcta. Y el sellado ocurría PEREZOSAMENTE dentro de
  // `ensureInvoicePdf`, así que quien lo disparaba era el CLIENTE FINAL abriendo su PDF por
  // una ruta pública. Naciendo `pendiente_de_sellado`, esa ventana deja de ser una anomalía y
  // pasa a ser un estado legítimo, visible y reintentable — y el fail-open de SCRUM-206 cae
  // solo: si el sellado falla, la factura SE QUEDA donde nació, sin caso especial.
  //
  // El DEFAULT es `pendiente_de_sellado` aunque la mayoría de documentos acaben en
  // `no_aplica`: así un camino de emisión que se olvide de fijarlo deja una factura VISIBLE y
  // sin PDF, en vez de una que se da por buena. Fail-closed por defecto.
  //
  // Valores (constantes en src/modules/invoicing/domain/selladoEstado.ts):
  //   pendiente_de_sellado · nació y aún no entró en la cadena. NO produce PDF ni QR.
  //   sellado              · tiene huella y está encadenada.
  //   no_aplica            · justificante `J-` o merchant no-ES: nunca entra en la cadena.
  vfEstado        String    @default("pendiente_de_sellado") @map("vf_estado")
  vfHash          String?   @map("vf_hash") // huella SHA-256 de esta factura
  vfPrevHash      String?   @map("vf_prev_hash") // huella de la factura anterior en la cadena
  // SCRUM-145: instante EXACTO (con huso) que entró en el cálculo de la huella. Sin él, el
  // registro emite `FechaHoraHusoGenRegistro` con el momento de la FACTURA, que no es el que
  // se hasheó → un tercero no puede recomputar la huella y verificarla. Es dato del REGISTRO,
  // no de la factura: por eso columna propia y no se deriva de createdAt.
  vfTimestamp     DateTime? @map("vf_timestamp")
  // SCRUM-145: huella y sello del registro de ANULACIÓN. Es un registro DISTINTO del de alta,
  // con su propia huella encadenada — NO sustituye a `vfHash` (la factura anulada conserva la
  // suya; regla 29: una emitida jamás se edita ni borra, solo se anula CON su registro).
  vfAnulHash      String?   @map("vf_anul_hash")
  vfAnulTimestamp DateTime? @map("vf_anul_timestamp")
  // SCRUM-145d: eslabón anterior de la ANULACIÓN, PERSISTIDO. Antes se resolvía por sello al
  // emitir (el registro inmediatamente anterior), lo que es frágil justo donde no puede serlo:
  // con dos anulaciones próximas en el tiempo el orden por sello puede empatar o invertirse, y
  // esto se sella PARA SIEMPRE en una cadena de huellas. Se guarda lo que de verdad se hasheó,
  // igual que `vfPrevHash` hace con el alta — un dato, no una inferencia.
  vfAnulPrevHash  String?   @map("vf_anul_prev_hash")

  // Recordatorios de pago automáticos
  reminder7SentAt  DateTime? @map("reminder_7_sent_at") // fecha 1er recordatorio (7 días)
  reminder14SentAt DateTime? @map("reminder_14_sent_at") // fecha 2º recordatorio (14 días)

  createdAt DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  quote    Quote?   @relation(fields: [quoteId], references: [id])
  charge   Charge?  @relation(fields: [chargeId], references: [id])

  rectifies   Invoice?  @relation("Rectification", fields: [rectifiesId], references: [id])
  rectifiedBy Invoice[] @relation("Rectification")

  // El número es único POR MERCHANT (antes era único global: dos merchants con el
  // mismo prefijo "CF" colisionaban; la serie es del emisor, no de la plataforma)
  @@unique([merchantId, number])
  @@map("invoices")
}

model Expense {
  id         Int  @id @default(autoincrement())
  merchantId Int  @map("merchant_id")
  quoteId    Int? @map("quote_id")
  providerId Int? @map("provider_id")

  concept               String
  amount                Decimal   @db.Decimal(12, 2)
  currency              String    @default("EUR") @db.VarChar(3)
  category              String    @default("otros") // materiales|desplazamiento|herramientas|subcontrata|otros
  date                  DateTime  @default(now())
  notes                 String?
  receiptData           String?   @map("receipt_data") @db.Text
  // ─────────────────────────────────────────────────────────────────────────────────────
  // SCRUM-403 / A5 / E4 · EL GASTO NO DICE SI LLEVA IVA, Y TRES CIFRAS DEPENDEN DE ESO.
  //
  // `amount` es AMBIGUO POR DISEÑO: nadie escribió nunca si es con IVA o sin él. Sobre esa
  // ambigüedad se apoyan el «beneficio neto» (resta base contra base), el 303 (IVA soportado
  // deducible) y el libro de facturas recibidas (E4).
  //
  // ⚠️ TODAS NULLABLE Y SIN `@default`, y no es prudencia: `null` ES UN DATO. Significa «este
  // gasto es un apunte de caja, no un asiento». Un `@default` rellenaría el pasado con una
  // suposición y la haría INDISTINGUIBLE de un dato real — que es exactamente el defecto que
  // SCRUM-403 denuncia. NO HAY BACKFILL: deducir la base de `amount` exige saber si lleva IVA
  // y a qué tipo, y eso no está escrito en ninguna parte.
  baseAmount            Decimal?  @map("base_amount") @db.Decimal(12, 2)
  // Tipo en ENTERO DE PORCENTAJE (21/10/4/0) — la convención de `AlbaranLinea.tipoIva`, NO la
  // fracción de `Quote.lines[].tax`. Mezclar las dos multiplica el IVA por cien sin que nada falle.
  vatRate               Int?      @map("vat_rate")
  // La cuota SE GUARDA, no se recalcula: un redondeo distinto entre pantalla y libro es una
  // discrepancia que después nadie sabe explicar.
  vatAmount             Decimal?  @map("vat_amount") @db.Decimal(12, 2)
  // `null` = nunca clasificado · `false` = se decidió que NO. No son lo mismo, y por eso no lleva
  // `@default` (convención de `Customer.tipoDestinatario`, SCRUM-69).
  vatDeducible          Boolean?  @map("vat_deducible")
  // El nº y serie de la factura DEL PROVEEDOR: es lo que identifica el asiento de compra (E4).
  providerInvoiceNumber String?   @map("provider_invoice_number")
  // Fecha de EXPEDICIÓN del proveedor. `Expense.date` es la del apunte, y no son la misma.
  providerInvoiceDate   DateTime? @map("provider_invoice_date")

  // SCRUM-109 (carril A, bloqueante de SCRUM-107 V2): autoría del gasto — el técnico que lo
  // registró desde la furgoneta. Int? con null = propietario, misma convención que
  // Quote.teamMemberId / Job.operarioId (SCRUM-52): sin relación Prisma declarada a propósito
  // (ese es el patrón ya asentado). Se rellena en createExpense con el teamMemberId de la
  // sesión. NO se usa aún para filtrar/mostrar — eso es la V2 de SCRUM-107, carril B (Javier).
  teamMemberId Int? @map("team_member_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  merchant Merchant  @relation(fields: [merchantId], references: [id])
  quote    Quote?    @relation(fields: [quoteId], references: [id])
  provider Provider? @relation(fields: [providerId], references: [id])

  @@index([merchantId])
  @@index([merchantId, quoteId])
  @@index([merchantId, date])
  @@index([merchantId, teamMemberId])
  @@map("expenses")
}

model Product {
  id         Int @id @default(autoincrement())
  merchantId Int @map("merchant_id")

  name        String
  nameSearch  String?  @map("name_search")
  description String?
  price       Decimal  @db.Decimal(12, 2)
  cost        Decimal? @db.Decimal(12, 2)
  vat         Decimal? @db.Decimal(5, 4)
  providerId  Int?     @map("provider_id")
  isActive    Boolean  @default(true) @map("is_active")
  // SCRUM-609 (CAT-01) · el LADO del catálogo: PRODUCTO | SERVICIO. Mismo patrón y misma forma
  // que `contactKind` (CONT-01): nullable y SIN `@default`, porque un default declararía por el
  // profesional. NULL = sin clasificar, y el switch no preselecciona ningún lado.
  //
  // 🔴 NO es una etiqueta que se guarda: DECIDE QUÉ CAMPOS ENSEÑA la ficha. Un servicio no tiene
  // coste, ni margen, ni proveedor. El valor va en mayúsculas y sin acentos por consistencia con
  // `contact_kind`, que es lo que ya está mergeado.
  itemKind    String?  @map("item_kind")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  merchant Merchant  @relation(fields: [merchantId], references: [id])
  provider Provider? @relation(fields: [providerId], references: [id])

  @@unique([merchantId, nameSearch])
  @@index([merchantId])
  @@index([merchantId, nameSearch])
  @@index([providerId])
  @@map("products")
}

model Provider {
  id         Int @id @default(autoincrement())
  merchantId Int @map("merchant_id")

  name      String
  phone     String?
  email     String?
  // SCRUM-441 (E4) · la razon social del proveedor. `Provider` tenia `tax_id` pero no el nombre
  // fiscal: sin el, el libro de recibidas identifica al proveedor por el mote de la libreta.
  legalName String? @map("legal_name")
  notes     String?
  // E4 · el NIF del proveedor. `Provider` no tenía HOY NINGÚN campo fiscal (medido: 0), y sin
  // NIF no hay asiento de compra. Nullable: los proveedores ya dados de alta no lo tienen y
  // no se puede deducir de nada.
  taxId     String? @map("tax_id")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  merchant Merchant  @relation(fields: [merchantId], references: [id])
  Product  Product[]
  Expense  Expense[]

  @@index([merchantId])
  @@map("providers")
}

model QuoteRequest {
  id         Int @id @default(autoincrement())
  merchantId Int @map("merchant_id")
  customerId Int @map("customer_id")

  description String @db.Text
  status      String @default("pending") // pending | read | done

  // BOT-1 (K1): zona aproximada y origen de la solicitud ('whatsapp_bot')
  zone   String? @map("zone")
  source String? @map("source")

  createdAt DateTime @default(now()) @map("created_at")

  merchant Merchant @relation(fields: [merchantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([merchantId, status])
  @@index([customerId])
  @@map("quote_requests")
}

// BOT-1 (K1): sesión del bot entrante — el número es COMPARTIDO entre
// merchants; la sesión fija el contexto y el estado del flujo (regla 27:
// estados de K1). Expira a las 24h (ventana de servicio de Meta).
model BotSession {
  id         Int      @id @default(autoincrement())
  phone      String // normalizado (normalizePhone)
  merchantId Int?     @map("merchant_id")
  state      String   @default("menu") // menu|choosing_merchant|asking_description|asking_zone|done|handoff (K1)
  data       Json?
  expiresAt  DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([phone, expiresAt])
  @@map("bot_sessions")
}

model QuoteTemplate {
  id         Int @id @default(autoincrement())
  merchantId Int @map("merchant_id")

  name         String
  currency     String  @default("EUR") @db.VarChar(3)
  lines        Json // Array de líneas igual que en Quote
  tiers        Json? // Opcional: Good/Better/Best
  paymentTerms String? @map("payment_terms") // FULL_UPFRONT | FIFTY_FIFTY | MANUAL

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
  @@map("quote_templates")
}

model TeamMember {
  id         Int @id @default(autoincrement())
  merchantId Int @map("merchant_id")

  name   String
  email  String @unique
  role   String @default("tecnico") // admin | tecnico
  status String @default("invited") // invited | active | suspended

  merchant       Merchant      @relation(fields: [merchantId], references: [id])
  authSessions   AuthSession[]
  // SCRUM-650 (T1): los trabajos que tiene asignados. Virtual, sin columna.
  jobAssignments JobAssignee[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([merchantId])
  @@map("team_members")
}

// ENT-3: historial de comunicaciones/actividad por cliente (timeline en Customer 360).
model CustomerEvent {
  id         Int @id @default(autoincrement())
  merchantId Int @map("merchant_id")
  customerId Int @map("customer_id")

  type   String // quote_sent | quote_accepted | quote_rejected | invoice_issued | payment_received | reminder_sent | quote_requested | review_requested
  title  String
  detail String?
  meta   Json?

  createdAt DateTime @default(now()) @map("created_at")

  merchant Merchant @relation(fields: [merchantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId, createdAt])
  @@index([merchantId])
  @@map("customer_events")
}

// WA-0b (master J4 · Parte L): log y estados de entrega de los mensajes de WhatsApp.
// Tabla independiente (sin FKs) para mantenerla aditiva y tolerante: el código que la
// escribe captura el error si aún no existe en prod (patrón ENT-3). El waMessageId mapea
// los webhooks de estado (rama `statuses`) de vuelta al mensaje.
model WhatsAppMessage {
  id         Int  @id @default(autoincrement())
  merchantId Int  @map("merchant_id")
  customerId Int? @map("customer_id")

  type         String // 'template' | 'service'
  templateName String? @map("template_name")
  waMessageId  String? @unique @map("wa_message_id") // id que devuelve Meta (wamid.*)

  status String  @default("queued") // queued → sent → delivered → read | failed
  error  String?

  // Documento relacionado para el chip de entrega (quote | invoice | charge)
  relatedType String? @map("related_type")
  relatedId   Int?    @map("related_id")

  costEstimate Decimal? @map("cost_estimate") @db.Decimal(8, 4) // € estimados (utility ES ~0,023)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([merchantId, createdAt])
  @@index([relatedType, relatedId])
  @@map("whatsapp_messages")
}

// A10.1 (EXT3): evidencia de aceptación de documentos legales (p. ej. alcance
// beta founding, regla 25). La versión es el hash del texto servido: si el
// asesor cambia el documento, la aceptación antigua deja de valer para checkout.
model LegalAcceptance {
  id           Int      @id @default(autoincrement())
  merchantId   Int      @map("merchant_id")
  teamMemberId Int?     @map("team_member_id")
  docKey       String   @map("doc_key") // 'alcance-beta'
  version      String // hash sha256 (12 hex) del texto mostrado
  ip           String?
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([merchantId, docKey])
  @@map("legal_acceptances")
}

// A13 (EXT3, JOB-1): Trabajo mínimo — feature de DINERO (V2: el resto jamás se
// cobra solo). FSM Parte L: pendiente_agendar→agendado→en_curso→terminado→cerrado.
model Job {
  id             Int       @id @default(autoincrement())
  merchantId     Int       @map("merchant_id")
  customerId     Int       @map("customer_id")
  quoteId        Int?      @unique @map("quote_id")
  status         String    @default("pendiente_agendar")
  scheduledAt    DateTime? @map("scheduled_at")
  assignedUserId Int?      @map("assigned_user_id") // teamMember (Equipo)
  notes          String?
  // SCRUM-10 (TRABAJO-1, 8-jul-2026): campos del contenedor "Trabajo" (ADITIVOS).
  // titulo/totalAceptado nullables para no romper Jobs existentes (serializeJob cae al
  // derivado si null); totalCobrado materializado NOT NULL default 0 (su lógica de sumar
  // los Charge pagados vive en SCRUM-13/COBROS-1, aquí solo se crea la columna).
  // direccion sin fuente hoy (ni Quote ni Customer la tienen) → se llenará en la UI (tarea futura).
  titulo         String?
  direccion      String?
  totalAceptado  Decimal?  @map("total_aceptado") @db.Decimal(12, 2)
  totalCobrado   Decimal   @default(0) @map("total_cobrado") @db.Decimal(12, 2)
  // SCRUM-52 (carril A, base de SCRUM-22): autoría del operario en el Trabajo =
  // creador del presupuesto (quote.teamMemberId) congelado en el accept. Distinto de
  // assignedUserId (el asignado a ejecutar). Int? con null = propietario, misma
  // convención que Quote.teamMemberId. NO se expone en serializer/UI aquí (eso es
  // SCRUM-22, carril B).
  operarioId     Int?      @map("operario_id")
  // SCRUM-66 (TRABAJO-4): tipo de operación fiscal del Trabajo — OPERACIONES_SUELTAS (varias
  // visitas → recapitulativa mensual, art. 13) | TRABAJO_UNICO (una prestación → factura al
  // concluir). Aditivo, NOT NULL default TRABAJO_UNICO = el caso ACTUAL de YaQu (1 presupuesto
  // aceptado = 1 trabajo) → los Jobs existentes quedan bien sin backfill. El MOTOR que respeta
  // la bandera es SCRUM-17; aquí solo se guarda la elección del pro (editable mientras esté abierto).
  tipoOperacion  String    @default("TRABAJO_UNICO") @map("tipo_operacion")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // SCRUM-651 (T2): que clase de intervencion es. Vocabulario CERRADO en
  // `src/modules/jobs/domain/tipoIntervencion.ts` — el MISMO que usa el parte (SCRUM-652).
  // Nullable y sin @default: los trabajos anteriores no declararon tipo, y «no consta» no es
  // ninguno de los valores del vocabulario.
  tipoIntervencion String? @map("tipo_intervencion")

  // SCRUM-650 (T1) · los empleados asignados a EJECUTAR este trabajo. Relacion virtual: no crea
  // ninguna columna en `jobs`. Destino final (paso C): esta tabla es la UNICA fuente y
  // `assignedUserId` desaparece — dos sitios diciendo quien ejecuta acaban discrepando.
  assignees JobAssignee[]

  @@index([merchantId, status])
  @@index([merchantId, scheduledAt])
  @@index([merchantId, operarioId])
  @@map("jobs")
}

// A15 (EXT3, MANT-1): mantenimientos recurrentes · flag MAINTENANCE_ENABLED (OFF)
model MaintenancePlan {
  id             Int       @id @default(autoincrement())
  merchantId     Int       @map("merchant_id")
  customerId     Int       @map("customer_id")
  quoteId        Int?      @map("quote_id")
  title          String
  intervalMonths Int       @map("interval_months")
  nextDueAt      DateTime  @map("next_due_at")
  active         Boolean   @default(true)
  // Anti-spam de la spec: 1 propuesta/cliente/90d · 2 rechazos seguidos → pausa
  lastProposedAt DateTime? @map("last_proposed_at")
  rejectedStreak Int       @default(0) @map("rejected_streak")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([merchantId, active, nextDueAt])
  @@map("maintenance_plans")
}

// A11.1 (EXT3, S2 F1-mínimo): auditoría — SOLO se escriben 4 acciones en F1
// (marcar_pagado_manual, deshacer_pago, anular_factura, cambio_flag); la forma
// es la del S2-F2 para no migrar después. La tabla events exige chargeId.
model AuditLog {
  id           Int      @id @default(autoincrement())
  merchantId   Int      @map("merchant_id")
  teamMemberId Int?     @map("team_member_id") // null = owner/admin
  action       String
  entityType   String?  @map("entity_type")
  entityId     Int?     @map("entity_id")
  meta         Json?
  ip           String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([merchantId, action, createdAt])
  // SCRUM-207 (D-1): el eje de la consulta de INSPECCIÓN es «qué pasó con la factura X»
  // (contrato §7.1 Q1), y el índice de arriba no lo sirve: pregunta por acción, no por
  // entidad. ÚNICO cambio de schema del ticket, ADITIVO y de rendimiento — no cambia
  // ninguna forma ni ningún dato.
  @@index([merchantId, entityType, entityId])
  @@map("audit_log")
}

// Ola 19 (EXT3, MEDIA-1 parcial): adjuntos. FASE 3 (7-jul-2026): activado con
// almacenamiento en Postgres (columnas `data`/`mime` aditivas) al no haber R2;
// el modelo abstrae el backend, así que migrar a R2 luego es un plug-in.
model Attachment {
  id         Int      @id @default(autoincrement())
  merchantId Int      @map("merchant_id")
  entityType String   @map("entity_type") // quote_request | job
  entityId   Int      @map("entity_id")
  url        String
  kind       String   @default("photo") // photo | audio (audio = F2, no F1)
  data       Bytes? // MEDIA-1: bytes del fichero en Postgres (bytea) — fallback persistente sin R2
  mime       String? // MEDIA-1: content-type (image/jpeg, image/png…)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([merchantId, entityType, entityId])
  @@map("attachments")
}

// SCRUM-14 (ALBARAN-1, 13-jul-2026): albarán / parte de trabajo — documento NO FISCAL
// (regla 24: jamás VeriFactu, serie fiscal, QR ni la palabra "factura"). Cuelga del Job
// (jobId Int sin relación Prisma declarada — mismo estilo que Job→Quote). SIN precios
// (decisión fundador: lineas = concepto/cantidad/unidad). Editable hasta 'firmado'
// (version++ con traza en AuditLog); firmado = congelado. Fotos vía Attachment
// entityType:'albaran'. Estados Parte L: borrador | emitido | firmado.
model Albaran {
  id                 Int       @id @default(autoincrement())
  merchantId         Int       @map("merchant_id")
  jobId              Int       @map("job_id")
  numero             String // ALB-YYYY-NNN, serie propia por merchant (no fiscal)
  fecha              DateTime  @default(now()) // fecha de la visita/entrega (editable en borrador)
  // SCRUM-300 (C5): un albarán se PREPARA un día y se ENTREGA otro, y hasta hoy solo existía
  // `fecha`. `fechaEntrega` es el día real de la entrega. null = no se pidió (todo lo anterior
  // a esta tarea) y entonces se muestra `fecha`, que es lo único que llegamos a saber.
  fechaEntrega       DateTime? @map("fecha_entrega")
  // SCRUM-300 (C5): DÓNDE se entregó. NO es `Job.direccion` —que no la escribe nadie: medido,
  // ningún schema de validación la acepta y sus únicas apariciones son lecturas— ni el domicilio
  // del cliente, que ni siquiera existe en `Customer`. Es un campo PROPIO del albarán, porque el
  // lugar del trabajo puede no ser el domicilio de quien paga.
  // ⚠️ Entra en el CONTENIDO SELLADO por la firma → sube `evidenciaFirma.v` a 2.
  lugarEntrega       String?   @map("lugar_entrega")
  // SCRUM-65: SIN_VALORAR (hoy, sin precios) | VALORADO (líneas con precioUnitario+tipoIva
  // opcionales). Aditivo, default SIN_VALORAR = comportamiento actual intacto. Editable solo
  // en 'borrador' (mismo candado que lineas/notas/fecha); congelado desde 'emitido'.
  modoValoracion     String    @default("SIN_VALORAR") @map("modo_valoracion")
  lineas             Json // [{concepto, cantidad, unidad, precioUnitario?, tipoIva?}] (SCRUM-65)
  estado             String    @default("borrador") // borrador | emitido | firmado (Parte L)
  version            Int       @default(1)
  signatureUrl       String?   @map("signature_url") @db.Text // data-URI (patrón Quote.signatureUrl)
  firmadoAt          DateTime? @map("firmado_at")
  // SCRUM-300 (C5): QUIÉN firmó, y EN CALIDAD DE QUÉ. Hasta ahora se guardaba el trazo
  // (`signatureUrl`) y nada más: una rúbrica anónima no identifica a nadie, así que el albarán
  // firmado valía poco como prueba de entrega.
  // ⚠️ El campo se guarda VACÍO y se ofrece un chip de sugerencia de un toque con el nombre del
  // cliente: prerrellenarlo sería poner en boca del firmante una declaración que no ha hecho —si
  // firma el encargado y no lo corrige, guardaríamos un NOMBRE FALSO, peor que un hueco.
  // Por lo mismo, `firmadoPorCalidad` no tiene default: ninguna opción viene marcada.
  // null = no se pidió al firmar (albaranes anteriores a esta tarea). AMBOS entran en el
  // contenido sellado → `evidenciaFirma.v` = 2.
  firmadoPorNombre   String?   @map("firmado_por_nombre")
  firmadoPorCalidad  String?   @map("firmado_por_calidad")
  // SCRUM-49: firma REMOTA. `firmaToken` = token OPACO de la página pública /albaran/:token
  // (patrón Customer.portalToken, crypto.randomBytes(16).hex; null hasta enviar "para firmar";
  // @unique para el lookup findUnique). FSM SIN cambios (opción A): "esperando firma" se deriva
  // de `enviadoParaFirmaAt != null && estado === 'emitido'`, no es un estado nuevo (Parte L intacta).
  firmaToken         String?   @unique @map("firma_token")
  enviadoParaFirmaAt DateTime? @map("enviado_para_firma_at")
  // SCRUM-68: evidencias probatorias de la firma — { v, canal(remoto|in_situ), firmadoAt, ip, ua,
  // tokenId, firmante, hashAlg, contentHash }. El hash es del CONTENIDO canónico (no del PDF, §1.3).
  // ⚠️ IP y UA son datos personales → viven SOLO aquí; NUNCA se exponen (ni PDF, ni HTML público,
  // ni serializer/API del cliente). Aditivo, Json nullable.
  evidenciaFirma     Json?     @map("evidencia_firma")
  notas              String?   @db.Text
  pdfUrl             String?   @map("pdf_url")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  // SCRUM-17 (FISCAL-2): factura recapitulativa que consolidó este albarán (null = no facturado).
  // El badge "Facturado" se DERIVA de invoiceId != null (sin flag manual; FSM Parte L intacta, regla 27).
  invoiceId          Int?      @map("invoice_id")
  claveIdempotencia  String?   @map("clave_idempotencia") @db.VarChar(64)

  @@unique([merchantId, claveIdempotencia])
  @@unique([merchantId, numero])
  @@index([merchantId, jobId])
  @@index([merchantId, invoiceId])
  @@map("albaranes")
}

/// SCRUM-170 (FACT-2c) · LIBRO de lo facturado por LÍNEA de albarán.
///
/// POR QUÉ UNA TABLA Y NO UN `cantidadFacturada` DENTRO DEL JSON DE LA LÍNEA. Un contador
/// dentro del Json es un CONTADOR MUTABLE: se incrementa al facturar y hay que acordarse de
/// decrementarlo al anular. Eso es exactamente el flag manual que SCRUM-17 se negó a tener
/// citando la queja de DELSOL (albaranes que quedan "pendientes" y hay que arreglar a mano),
/// y la Parte L no admite estados almacenados nuevos (regla 27). Aquí cada fila dice QUÉ
/// factura se llevó QUÉ cantidad de QUÉ línea: lo facturado de una línea es la SUMA de sus
/// filas, y el estado de cobro del albarán se DERIVA comparando servido contra facturado.
/// Anular una factura no obliga a tocar ningún contador: se excluyen sus filas de la suma.
///
/// APPEND-ONLY: estas filas no se editan. Son el rastro de un documento fiscal ya emitido
/// (regla 29) y su cantidad tiene que seguir cuadrando con las líneas selladas en la huella.
///
/// Sin FK a propósito, siguiendo el patrón multi-tenant de columna de esta casa (WhatsAppMessage):
/// el barrido de los merchants efímeros lo hace `MODELOS_POR_MERCHANT` en la fixture de tests,
/// donde este modelo QUEDA REGISTRADO (SCRUM-172: una lista a mano que no sigue al esquema deja
/// huérfanas en silencio).
model AlbaranLineaFacturada {
  id         Int      @id @default(autoincrement())
  merchantId Int      @map("merchant_id")
  albaranId  Int      @map("albaran_id")
  /// Índice de la línea dentro de `Albaran.lineas` (el Json es un array ordenado).
  lineaIndex Int      @map("linea_index")
  /// Factura que se llevó esta cantidad. Es el enlace que permite deshacer por anulación.
  invoiceId  Int      @map("invoice_id")
  /// Cantidad facturada en ESA factura de ESA línea. Tres decimales: las unidades de obra
  /// (horas, m², kg) se sirven fraccionadas y redondear aquí desplazaría el importe emitido.
  cantidad   Decimal  @db.Decimal(12, 3)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([merchantId, albaranId])
  @@index([merchantId, invoiceId])
  @@map("albaran_lineas_facturadas")
}

model EmailMessage {
  id         Int  @id @default(autoincrement())
  merchantId Int  @map("merchant_id")
  customerId Int? @map("customer_id")

  kind       String // invoice | quote | magic_link | digest | ...
  toEmail    String  @map("to_email")
  providerId String? @unique @map("provider_id") // id de Resend; NULL = no consta

  // ESTADOS_CORREO (constanciaCorreo.ts). `aceptado_*` NO es «entregado».
  status String  @default("aceptado_sin_identificador")
  error  String?

  relatedType String? @map("related_type") // invoice | quote | charge
  relatedId   Int?    @map("related_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([merchantId, createdAt])
  @@index([relatedType, relatedId])
  @@map("email_messages")
}

// SCRUM-650 (T1) · UN TRABAJO SE ASIGNA A VARIOS EMPLEADOS
//
// El caso real que lo pide: en el parte de trabajo EN PAPEL de la empresa de Madrid, el campo
// «Tecnico» dice literalmente «Israel, Miguel y Jesus.L». VARIOS no es el caso raro: es el normal.
//
// TABLA PUENTE, y no un array ni un CSV en `jobs`:
//   · un array de ids no tiene integridad referencial — nada impide guardar el id de un empleado
//     borrado, o de otro merchant;
//   · un CSV no se puede indexar ni filtrar, y el filtro por empleado es EXACTAMENTE lo que este
//     ticket existe para que funcione.
//
// La clave primaria compuesta hace la asignacion idempotente: asignar dos veces al mismo no crea
// dos filas. El indice por `team_member_id` es el que sirve la pregunta del tecnico —«que trabajos
// tengo»—, que es la consulta caliente.
//
// ⚠️ Un trabajo SIN NINGUN asignado es INVISIBLE para todos los tecnicos; solo lo ven los admin.
// Hoy ya puede quedarse sin nadie (`assignedUserId` es nullable) y esto no lo cambia: lo DICE.
model JobAssignee {
  jobId        Int      @map("job_id")
  teamMemberId Int      @map("team_member_id")
  assignedAt   DateTime @default(now()) @map("assigned_at")

  job        Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  // onDelete: Cascade en LAS DOS. Sin el, la FK es RESTRICT y borrar un empleado —o su merchant—
  // revienta a mitad de recorrido con las tablas anteriores ya vaciadas (lo cazo SCRUM-244). Y es
  // lo correcto ademas de lo seguro: una asignacion no significa nada sin la persona asignada.
  teamMember TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  @@id([jobId, teamMemberId])
  @@index([teamMemberId])
  @@map("job_assignees")
}

// SCRUM-652 (T3) · EL PARTE DE TRABAJO. Documento propio: no es un albaran ni una factura,
// y por eso NO comparte tabla con ellos. Sin relaciones Prisma declaradas (merchantId/jobId/
// customerId sueltos), misma convencion que el resto del schema (SCRUM-192).
model ParteTrabajo {
  id         Int  @id @default(autoincrement())
  merchantId Int  @map("merchant_id")
  jobId      Int? @map("job_id")
  customerId Int? @map("customer_id")

  numero     String
  fecha      DateTime
  obra       String?
  referencia String?

  entrada         String?
  salida          String?
  desplazamientos Int?
  kilometros      Decimal? @db.Decimal(10, 2)
  /// Array de nombres. Ranura para «varios técnicos» (sesión 1), que HOY NO EXISTE.
  tecnicos        Json     @default("[]")

  /// reparacion_asistencia | mantenimiento | instalacion (TIPOS_PARTE)
  tipo   String?
  /// [{bloque, unds, descripcion, precioUnitario?, tipoIva?}] — el bloque va DENTRO de la línea
  lineas Json
  notas  String?

  /// borrador | firmado | facturado (ESTADOS_PARTE)
  estado String @default("borrador")

  firmadoAt         DateTime? @map("firmado_at")
  firmadoPorNombre  String?   @map("firmado_por_nombre")
  firmadoPorCalidad String?   @map("firmado_por_calidad")
  /// Huella del CONTENIDO (sin precios) y su versión de canónico.
  contenidoHash     String?   @map("contenido_hash")
  contenidoVersion  Int?      @map("contenido_version")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([merchantId, fecha])
  @@index([merchantId, estado])
  @@map("partes_trabajo")
}
