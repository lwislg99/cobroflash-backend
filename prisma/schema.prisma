generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Merchant {
  id        Int       @id @default(autoincrement())
  name      String
  country   String
  pspId     String?   @map("psp_id")
  iban      String?
  clabe     String?
  status    String    @default("active")
  charges   Charge[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  Quote     Quote[]
  Invoice   Invoice[]

  @@index([country])
  @@map("merchants")
}

model Customer {
  id        Int       @id @default(autoincrement())
  name      String
  phone     String?
  email     String?
  notes     String?
  charges   Charge[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  Quote     Quote[]
  Invoice   Invoice[]

  @@map("customers")
}

model Charge {
  id         Int       @id @default(autoincrement())
  merchantId Int       @map("merchant_id") // <- Int (FK)
  customerId Int?      @map("customer_id") // <- Int? (FK)
  concept    String    @map("concepto")
  amount     Decimal   @map("importe") @db.Decimal(12, 2)
  currency   String    @map("moneda")
  method     String // SCTinst | SPEI | Pix | card
  status     String // pending | paid | expired | failed
  expiresAt  DateTime? @map("vencimiento")
  reference  String?   @map("referencia")
  intentId   String?   @map("intent_id")

  merchant        Merchant         @relation(fields: [merchantId], references: [id])
  customer        Customer?        @relation(fields: [customerId], references: [id])
  events          Event[]
  reconciliations Reconciliation[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  Quote     Quote[]

  @@index([merchantId, status])
  @@index([customerId])
  @@index([status, expiresAt])
  @@map("charges")
}

model Event {
  id       Int      @id @default(autoincrement())
  chargeId Int      @map("charge_id") // <- Int (FK)
  type     String // created | sent | paid | expired | failed | refunded
  payload  Json?
  ts       DateTime @default(now())

  charge Charge @relation(fields: [chargeId], references: [id])

  @@index([chargeId, type])
  @@map("events")
}

model Reconciliation {
  id       Int      @id @default(autoincrement())
  chargeId Int      @map("charge_id") // <- Int (FK)
  bankRef  String?  @map("bank_ref")
  matched  Boolean  @default(false)
  ts       DateTime @default(now())

  charge Charge @relation(fields: [chargeId], references: [id])

  @@index([chargeId, matched])
  @@map("reconciliations")
}

model Quote {
  id         Int       @id @default(autoincrement())
  merchantId Int
  customerId Int
  status     String    @default("draft") // draft|sent|accepted|rejected
  total      Decimal   @db.Decimal(12, 2)
  currency   String    @db.VarChar(3)
  lines      Json
  acceptedAt DateTime?
  evidence   Json?
  chargeId   Int?

  // Relaciones
  merchant Merchant @relation(fields: [merchantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  charge   Charge?  @relation(fields: [chargeId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  Invoice   Invoice[]

  @@map("quotes")
}

model Invoice {
  id         Int      @id @default(autoincrement())
  merchantId Int
  customerId Int
  quoteId    Int?
  number     String   @unique
  total      Decimal  @db.Decimal(12, 2)
  currency   String   @db.VarChar(3)
  pdfUrl     String
  qrData     String
  registerId String?
  createdAt  DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  quote    Quote?   @relation(fields: [quoteId], references: [id])

  @@map("invoices")
}
