generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Merchant {
  id Int @id @default(autoincrement())

  name        String
  email       String?  @unique
  legalName   String?  @map("legal_name")
  taxId       String?  @map("tax_id")
  address     String?  @map("address")

  defaultCurrency      String  @default("EUR") @map("default_currency")
  invoiceSeriesPrefix  String  @default("CF")  @map("invoice_series_prefix")
  nextInvoiceNumber    Int     @default(1)      @map("next_invoice_number")
  logoUrl              String? @map("logo_url")
  whatsappPhone        String? @map("whatsapp_phone")
  googleReviewUrl      String? @map("google_review_url")

  // Auth / plan
  onboardingCompleted  Boolean   @default(false)  @map("onboarding_completed")
  plan                 String    @default("trial")             // trial | basic | pro | empresa
  planExpiresAt        DateTime? @map("plan_expires_at")
  stripeCustomerId     String?   @map("stripe_customer_id")
  stripeSubscriptionId String?   @map("stripe_subscription_id")

  country String
  pspId   String? @map("psp_id")
  iban    String?
  clabe   String?
  status  String  @default("active")

  charges     Charge[]
  Quote       Quote[]
  Invoice     Invoice[]
  Product     Product[]
  Provider    Provider[]
  Customer    Customer[]
  AuthSession AuthSession[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@index([country])
  @@map("merchants")
}

model AuthSession {
  id         Int       @id @default(autoincrement())
  merchantId Int       @map("merchant_id")
  token      String    @unique
  type       String    @default("session") // magic_link | session
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@index([token])
  @@index([merchantId])
  @@map("auth_sessions")
}

model Customer {
  id         Int  @id @default(autoincrement())
  merchantId  Int     @default(1) @map("merchant_id")
  name        String
  phone       String?
  email       String?
  notes       String?
  portalToken String? @unique @map("portal_token")

  merchant  Merchant  @relation(fields: [merchantId], references: [id])
  charges   Charge[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt      @map("updated_at")
  Quote     Quote[]
  Invoice   Invoice[]

  @@index([merchantId])
  @@map("customers")
}

model Charge {
  id         Int       @id @default(autoincrement())
  merchantId Int       @map("merchant_id")
  customerId Int?      @map("customer_id")
  concept    String    @map("concepto")
  amount     Decimal   @map("importe") @db.Decimal(12, 2)
  currency   String    @map("moneda")
  method     String
  status     String
  expiresAt  DateTime? @map("vencimiento")
  reference  String?   @map("referencia")
  intentId   String?   @map("intent_id")

  merchant        Merchant         @relation(fields: [merchantId], references: [id])
  customer        Customer?        @relation(fields: [customerId], references: [id])
  events          Event[]
  reconciliations Reconciliation[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt      @map("updated_at")
  Quote     Quote[]
  invoices  Invoice[]

  @@index([merchantId, status])
  @@index([customerId])
  @@index([status, expiresAt])
  @@map("charges")
}

model Event {
  id       Int      @id @default(autoincrement())
  chargeId Int      @map("charge_id")
  type     String
  payload  Json?
  ts       DateTime @default(now())

  charge Charge @relation(fields: [chargeId], references: [id])

  @@index([chargeId, type])
  @@map("events")
}

model Reconciliation {
  id       Int      @id @default(autoincrement())
  chargeId Int      @map("charge_id")
  bankRef  String?  @map("bank_ref")
  matched  Boolean  @default(false)
  ts       DateTime @default(now())

  charge Charge @relation(fields: [chargeId], references: [id])

  @@index([chargeId, matched])
  @@map("reconciliations")
}

model Quote {
  id         Int @id @default(autoincrement())
  merchantId Int
  customerId Int

  status       String  @default("draft")
  total        Decimal @db.Decimal(12, 2)
  currency     String  @db.VarChar(3)
  lines        Json
  acceptedAt   DateTime?
  paymentTerms String?
  rejectedAt   DateTime?
  decisionChannel String?
  decisionComment String?
  rejectionReason String?
  pdfUrl          String?   @db.Text
  signatureUrl    String?   @db.Text
  tiers           Json?                // Array de 3 opciones Good/Better/Best
  selectedTierId  String?              // 'good' | 'better' | 'best' — elegido por el cliente
  evidence        Json?
  chargeId        Int?
  reminderSentAt  DateTime?

  merchant Merchant @relation(fields: [merchantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  charge   Charge?  @relation(fields: [chargeId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  Invoice   Invoice[]

  @@map("quotes")
}

model Invoice {
  id         Int  @id @default(autoincrement())
  merchantId Int
  customerId Int
  quoteId    Int?
  chargeId   Int? @map("charge_id")

  number     String  @unique
  total      Decimal @db.Decimal(12, 2)
  currency   String  @db.VarChar(3)
  pdfUrl     String
  qrData     String
  registerId String?

  status        String    @default("pending") @map("status")
  paidAt        DateTime? @map("paid_at")
  clientComment String?   @map("client_comment")

  createdAt DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  quote    Quote?   @relation(fields: [quoteId], references: [id])
  charge   Charge?  @relation(fields: [chargeId], references: [id])

  @@map("invoices")
}

model Product {
  id         Int @id @default(autoincrement())
  merchantId Int @map("merchant_id")

  name        String
  nameSearch  String?  @map("name_search")
  description String?
  price       Decimal  @db.Decimal(12, 2)
  cost        Decimal? @db.Decimal(12, 2)
  vat         Decimal? @db.Decimal(5, 4)
  providerId  Int?     @map("provider_id")
  isActive    Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  merchant Merchant  @relation(fields: [merchantId], references: [id])
  provider Provider? @relation(fields: [providerId], references: [id])

  @@unique([merchantId, nameSearch])
  @@index([merchantId])
  @@index([merchantId, nameSearch])
  @@index([providerId])
  @@map("products")
}

model Provider {
  id         Int @id @default(autoincrement())
  merchantId Int @map("merchant_id")

  name     String
  phone    String?
  email    String?
  notes    String?
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  merchant Merchant  @relation(fields: [merchantId], references: [id])
  Product  Product[]

  @@index([merchantId])
  @@map("providers")
}
