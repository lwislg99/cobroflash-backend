generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Merchant {
  id         Int       @id @default(autoincrement())
  name       String
  country    String
  pspId      String?   @map("psp_id")
  iban       String?
  clabe      String?
  status     String    @default("active")
  charges    Charge[]
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([country])
  @@map("merchants")
}

model Customer {
  id         Int       @id @default(autoincrement())
  name       String
  phone      String?
  email      String?
  notes      String?
  charges    Charge[]
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@map("customers")
}

model Charge {
  id             Int       @id @default(autoincrement())
  merchantId     Int       @map("merchant_id")          // <- Int (FK)
  customerId     Int?      @map("customer_id")          // <- Int? (FK)
  concept        String    @map("concepto")
  amount         Decimal   @db.Decimal(12, 2) @map("importe")
  currency       String    @map("moneda")
  method         String    // SCTinst | SPEI | Pix | card
  status         String    // pending | paid | expired | failed
  expiresAt      DateTime? @map("vencimiento")
  reference      String?   @map("referencia")
  intentId       String?   @map("intent_id")

  merchant       Merchant  @relation(fields: [merchantId], references: [id])
  customer       Customer? @relation(fields: [customerId], references: [id])
  events         Event[]
  reconciliations Reconciliation[]

  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([merchantId, status])
  @@index([customerId])
  @@index([status, expiresAt])
  @@map("charges")
}

model Event {
  id        Int      @id @default(autoincrement())
  chargeId  Int      @map("charge_id")                 // <- Int (FK)
  type      String   // created | sent | paid | expired | failed | refunded
  payload   Json?
  ts        DateTime @default(now())

  charge    Charge   @relation(fields: [chargeId], references: [id])

  @@index([chargeId, type])
  @@map("events")
}

model Reconciliation {
  id        Int      @id @default(autoincrement())
  chargeId  Int      @map("charge_id")                 // <- Int (FK)
  bankRef   String?  @map("bank_ref")
  matched   Boolean  @default(false)
  ts        DateTime @default(now())

  charge    Charge   @relation(fields: [chargeId], references: [id])

  @@index([chargeId, matched])
  @@map("reconciliations")
}
