{
  "name": "yaqu-backend",
  "version": "1.0.0",
  "private": true,
  "license": "ISC",
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "npm run build && node --test --test-force-exit tests/*.test.mjs",
    "test:staging": "npm run build && node --test --test-force-exit --test-concurrency=1 tests/*.test.mjs",
    "prisma:generate": "prisma generate",
    "db:push": "bash scripts/db-push-prod",
    "prisma:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "e2e:critico": "npm run build && node scripts/e2e-critico.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@prisma/client": "^6.18.0",
    "archiver": "^8.0.0",
    "axios": "^1.12.2",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.10",
    "pdfkit": "^0.17.2",
    "qrcode": "^1.5.4",
    "stripe": "^19.3.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.3",
    "@types/pdfkit": "^0.17.3",
    "@types/qrcode": "^1.5.6",
    "prisma": "^6.18.0",
    "puppeteer-core": "^25.3.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
