#!/usr/bin/env bash
# scripts/db-push-prod — SCRUM-40: aplicación GUIADA de schema con `prisma db push`.
#
# Automatiza los PASOS del patrón manual que hoy hacemos a mano, SIN automatizar la DECISIÓN:
#   host-check → preview (migrate diff) → [GO EXPLÍCITO del operador] → db push → verificación
#   → recordatorio de documentar en docs/MIGRATIONS_PENDING.md.
#
#
# ══════════════════════════════════════════════════════════════════════════════════════
# 🔴 `db push` NO ES EL MÉTODO DE ESTA CASA CONTRA PRODUCCIÓN (SCRUM-685, 2-sep-2026)
#
# `db push` reconcilia el esquema ENTERO. Producción va POR DELANTE de `main` en columnas que
# se aplican A MANO para desbloquear PRs que aún no se han mergeado, así que un push propondría
# BORRARLAS TODAS. No es un caso raro: es el comportamiento normal de este método aquí.
#
# EL ORDEN DE LA CASA:
#     ① decisión  →  ② ALTER aditivo en las TRES bases (dev, staging, prod)  →  ③ UN solo PR
#        con esquema + código + tests.     NUNCA ③ sin ②.
#
# El SQL del ② se escribe a mano en `docs/sql/`, se pasa por `scripts/_clasificador-sql.mjs`
# (cero rechazadas, cero DROP) y lo aplica una persona base por base. Ejemplo:
# `docs/sql/scrum-674-aditivo.sql`.
#
# Este script se conserva para STAGING y para diagnosticar deriva, y desde SCRUM-685 se niega a
# arrancar desde un árbol atrasado y aborta si el preview trae cualquier borrado. Pero el aviso
# va primero: si estás a punto de ejecutarlo contra producción, casi seguro que lo que quieres
# es un `.sql` aditivo, no esto.
# ══════════════════════════════════════════════════════════════════════════════════════
#
# Fuente de verdad: prisma/schema.prisma. Aplica a la BD de DATABASE_URL (.env = PROD).
#   Prod:     bash scripts/db-push-prod
#   Staging:  DATABASE_URL="postgresql://…acela…" bash scripts/db-push-prod
#
# NUNCA usa --accept-data-loss (regla 3/AA2). Si Prisma pidiera confirmación de pérdida de datos,
# db push aborta solo → señal de diff INESPERADO → PARAR y revisar.
set -euo pipefail
cd "$(dirname "$0")/.."

# ── 0) SCRUM-685 · LA PUERTA DEL ÁRBOL, antes de enseñar una sola línea de SQL ──
#
# El 2-sep-2026 este script se ejecutó desde un checkout 1.933 commits atrasado y su preview
# propuso DROP TABLE job_assignees, DROP TABLE email_messages y ~30 columnas de PRODUCCIÓN. El
# script hizo lo que promete; lo que estaba mal era el árbol. Lo pararon el GO explícito y que
# aquel shell no tenía stdin — la segunda es SUERTE, y esto la convierte en mecanismo.
#
# La lógica vive en `scripts/_guard-arbol-y-borrado.mjs` para que se pueda probar sin ejecutar
# esto: un guard que sólo se ejercita apuntando a producción no se ejercita nunca.
# Un aviso en un ticket se olvida; uno en la salida lo lee quien ejecuta.
echo ""
echo "══════════════════════════════════════════════════════════════════════════"
echo "🔴 db push NO es el metodo de esta casa contra PRODUCCION."
echo ""
echo "   Reconcilia el esquema ENTERO, y produccion va POR DELANTE de main en columnas"
echo "   aplicadas a mano para desbloquear PRs sin mergear: un push propondria borrarlas."
echo ""
echo "   El orden de la casa es:"
echo "     1) decision  ->  2) ALTER aditivo en las TRES bases  ->  3) UN solo PR"
echo "        (esquema + codigo + tests).   NUNCA 3) sin 2)."
echo ""
echo "   El 2) se escribe a mano en docs/sql/, se pasa por scripts/_clasificador-sql.mjs"
echo "   (cero rechazadas, cero DROP) y lo aplica una persona base por base."
echo "══════════════════════════════════════════════════════════════════════════"
echo ""

echo "── SCRUM-685 · ¿desde qué árbol se compara? ────────────────────────────"

set +e
ESTADO_ARBOL="$(node --input-type=module -e '
  import { execFileSync } from "node:child_process";
  const { estadoDelArbol } = await import("./scripts/_guard-arbol-y-borrado.mjs");
  const g = (args) => execFileSync("git", args, { encoding: "utf8" }).trim();
  const git = {
    fetch() {
      try { execFileSync("git", ["fetch", "origin", "--quiet"], { stdio: "ignore" }); return { ok: true }; }
      catch (e) { return { ok: false, error: (e && e.message) || "git fetch falló" }; }
    },
    detras: () => Number(g(["rev-list", "--count", "HEAD..origin/main"])),
    delante: () => Number(g(["rev-list", "--count", "origin/main..HEAD"])),
    sucioSchema: () => g(["status", "--porcelain", "--", "prisma/schema.prisma"]).length > 0,
    enElRemoto: () => g(["branch", "-r", "--contains", "HEAD"]).length > 0,
  };
  const r = estadoDelArbol(git);
  if (!r.puedeSeguir) { console.error(r.motivo); process.exit(9); }
  // El SHA del commit Y el del propio fichero de esquema: sin esto, quien lea el diff no sabe
  // de qué árbol salió, y un diff sin procedencia no se puede auditar después.
  console.log("   commit          : " + g(["rev-parse", "HEAD"]));
  console.log("   schema.prisma   : " + g(["rev-parse", "HEAD:prisma/schema.prisma"]));
  console.log("   respecto a main : " + r.estado + (r.delante ? " (+" + r.delante + ")" : ""));
' 2>&1)"
RC_ARBOL=$?
set -e

printf '%s\n' "$ESTADO_ARBOL"
if [ "$RC_ARBOL" -ne 0 ]; then
  echo ""
  echo "🚫 Abortado por la puerta del árbol. NO se ha tocado nada y NO se ha enseñado SQL."
  exit 1
fi
echo ""

# ── 1) Host-check — SIN parsear la URL a mano y SIN reconstruirla ──
#
# SCRUM-223: aquí estaba el bug que mataba el script. La versión anterior sacaba la URL del
# `.env` con `sed 's|^DATABASE_URL=||'` y la exportaba tal cual. Pero en `.env` el valor va
# ENTRECOMILLADO, así que exportaba `'postgresql://…'` **con las comillas dentro** → Prisma
# recibía una URL inválida, fallaba, su stderr se lo tragaba el `2>/dev/null` de abajo y
# `set -e` mataba el script justo después de imprimir la cabecera. Cabecera y silencio.
#
# Y es el MISMO defecto del incidente #14 (una credencial de producción publicada porque
# `new URL()` recibió la cadena con comillas y volcó su `.message`). Una causa, dos víctimas.
#
# Por eso el parseo NO se hace aquí: `parseBDSegura` (scripts/_db-guard.mjs) quita el
# envoltorio de comillas y **no tiene forma de devolver la cadena** — solo host, base, usuario
# y puerto. Regla de la casa: quien mira una URL de BD importa ese fichero.
#
# Y NO se reexporta nada: si `DATABASE_URL` viene del entorno, ya está puesta; si no, Prisma
# carga el `.env` por su cuenta (su dotenv sí quita las comillas bien). Aquí solo se MIRA a
# dónde apunta para poder avisar.
HOST="$(node --input-type=module -e '
  import fs from "node:fs";
  const { parseBDSegura } = await import("./scripts/_db-guard.mjs");
  let url = process.env.DATABASE_URL || "";
  if (!url && fs.existsSync(".env")) {
    const linea = fs.readFileSync(".env", "utf8").split(/\r?\n/).find((l) => /^DATABASE_URL=/.test(l));
    if (linea) url = linea.replace(/^DATABASE_URL=/, "");
  }
  const p = parseBDSegura(url);   // devuelve null si no se puede: nunca la cadena
  process.stdout.write(p ? p.host : "");
')"

if [ -z "$HOST" ]; then
  echo "❌ No pude resolver a qué BD apunta DATABASE_URL (ni del entorno ni de .env), o la URL"
  echo "   no es parseable. NO se dice cuál era: una URL de BD ilegible se diagnostica por su"
  echo "   origen, no imprimiéndola (regla R7 / incidente #14). Aborto sin tocar nada."
  exit 1
fi

case "$HOST" in
  autorack.proxy.rlwy.net) LABEL="🔴 PRODUCCIÓN (autorack)";;
  acela.proxy.rlwy.net)    LABEL="🟠 STAGING (acela)";;
  *)                       LABEL="⚠️  host DESCONOCIDO ($HOST)";;
esac
echo "🎯 Destino del db push: $LABEL"
echo ""

# ── 2) Preview (read-only): qué aplicaría el db push ──
#
# SCRUM-223 · SUELO ANTI-SILENCIO. Este paso tenía DOS formas de mentir y las dos daban el
# mismo aspecto que un preview vacío legítimo:
#   · `2>/dev/null` — el error de Prisma desaparecía sin dejar rastro.
#   · `set -e` sobre la sustitución — el script moría aquí mismo, sin una línea.
# Quien esperaba un diff vacío veía la cabecera, no veía SQL, y concluía «no hay nada que
# aplicar». En la puerta de producción, un silencio que se lee como dato.
#
# Ahora: stderr se CAPTURA (no se tira), el exit code se comprueba, y si el paso no produce
# absolutamente nada el script ABORTA. Un preview legítimamente vacío dice que está vacío —
# Prisma escribe «-- This is an empty migration.» — así que «sin salida» no puede ser normal.
echo "── PREVIEW · prisma migrate diff (BD → schema) ─────────────────────────"
ERR_TMP="$(mktemp)"
trap 'rm -f "$ERR_TMP"' EXIT

set +e
DIFF="$(npx prisma migrate diff \
  --from-schema-datasource prisma/schema.prisma \
  --to-schema-datamodel prisma/schema.prisma --script 2>"$ERR_TMP")"
RC=$?
set -e

if [ "$RC" -ne 0 ]; then
  echo "❌ El PREVIEW FALLÓ (exit $RC). No se ha aplicado NADA."
  echo "── stderr de prisma (con las credenciales redactadas) ──────────────────"
  # El stderr ajeno puede traer la URL dentro: se pasa por el redactor antes de enseñarlo.
  node --input-type=module -e '
    import fs from "node:fs";
    const { redactarSecretos } = await import("./scripts/_db-guard.mjs");
    process.stdout.write(redactarSecretos(fs.readFileSync(process.argv[1], "utf8")));
  ' "$ERR_TMP"
  exit 1
fi

printf '%s\n' "$DIFF"
echo "────────────────────────────────────────────────────────────────────────"

if [ -z "$(printf '%s' "$DIFF" | tr -d '[:space:]')" ]; then
  echo "❌ SUELO ANTI-SILENCIO: el preview terminó bien pero NO produjo ninguna salida."
  echo "   Eso no es «no hay nada que aplicar»: un diff vacío de verdad lo dice"
  echo "   («-- This is an empty migration.»). Sin salida = no sabemos el estado de la BD,"
  echo "   y no se aplica nada a ciegas. Aborto."
  exit 1
fi

if printf '%s' "$DIFF" | grep -qiE 'empty migration'; then
  echo "✅ Nada que aplicar: la BD ya está en sync con el schema. Salgo."
  exit 0
fi

# ── 2-bis) SCRUM-685 · SI EL PREVIEW BORRA, NO SE PIDE GO: SE ABORTA ──
#
# Un push de esquema y un borrado destructivo NO comparten aprobación. El borrado se aprueba en su
# propio ticket, o no se aprueba.
#
# 🔴 NO es un `grep DROP`: reutiliza `_clasificador-sql.mjs`, que desnuda comentarios y cadenas,
# trocea en sentencias y reconoce el `DROP COLUMN` DENTRO de un `ALTER TABLE` — que es justo como
# Prisma escribe los borrados. Un `grep` se caza a sí mismo con la palabra en un comentario, y ese
# defecto ya ocurrió una vez en esta casa.
DIFF_TMP="$(mktemp)"
printf '%s\n' "$DIFF" > "$DIFF_TMP"

set +e
INFORME_BORRADO="$(node --input-type=module -e '
  import fs from "node:fs";
  const { borradosDelPreview, informeDeBorrado } = await import("./scripts/_guard-arbol-y-borrado.mjs");
  const r = borradosDelPreview(fs.readFileSync(process.argv[1], "utf8"));
  if (r.hayBorrado || r.otrasNoAditivas.length) console.log(informeDeBorrado(r));
  process.exit(r.hayBorrado ? 9 : 0);
' "$DIFF_TMP" 2>&1)"
RC_BORRADO=$?
set -e
rm -f "$DIFF_TMP"

if [ -n "$INFORME_BORRADO" ]; then
  echo ""
  printf '%s\n' "$INFORME_BORRADO"
fi
if [ "$RC_BORRADO" -ne 0 ]; then
  echo ""
  echo "🚫 Abortado ANTES del GO. No se aplicó NADA."
  exit 1
fi

# ── 3) GO EXPLÍCITO — la DECISIÓN es humana, NO se automatiza ──
echo ""
printf 'Revisa el diff. Para APLICARLO a %s escribe exactamente GO (cualquier otra cosa aborta): ' "$LABEL"
read -r REPLY
if [ "$REPLY" != "GO" ]; then echo "🚫 Abortado (no escribiste GO). No se aplicó NADA."; exit 1; fi

# ── 4) db push SIN --accept-data-loss ──
#
# 🔴 SCRUM-746 (fase B) · AQUÍ ESTABA UN `touch .claude/allow-db-push`, Y SE HA QUITADO.
#
# El sentinel es la autorización de UN SOLO USO que el hook `guard-dangerous` exige antes de un
# `db push`. Este script se la concedía a sí mismo justo antes de empujar. La intención era buena
# —a estas alturas ya han pasado cinco puertas: árbol, host-check, preview con suelo
# anti-silencio, guard de borrado y el GO tecleado por una persona— pero el efecto no:
#
#   **quien lea el hook creerá que hubo un OK del fundador, y por esta ruta no lo hubo.**
#
# Y no era necesario: el hook intercepta lo que teclea Claude, no lo que hace un script por
# dentro, así que el `npx prisma db push` de la línea siguiente NO pasa por él. El `touch` no
# desbloqueaba nada — sólo dejaba escrito un permiso que nadie había dado.
#
# ⚠️ NO SE TOCA NADA MÁS DE ESTE SCRIPT. Sus cinco puertas funcionan y son mejores que lo que el
# hook podría añadir; medido en SCRUM-746 (fase A). Si algún día hiciera falta el sentinel de
# verdad, **lo pone una persona** — que es lo que significa una autorización.
echo ""
echo "── db push · $LABEL (sin --accept-data-loss) ──────────────────────────"
npx prisma db push --skip-generate

# ── 5) Verificación: el diff debe quedar vacío ──
echo ""
echo "── VERIFICACIÓN · migrate diff (debe estar vacío) ─────────────────────"
npx prisma migrate diff \
  --from-schema-datasource prisma/schema.prisma \
  --to-schema-datamodel prisma/schema.prisma --script

# ── 6) Recordatorio de documentar ──
echo ""
echo "✅ Aplicado a $LABEL."
echo "📝 AHORA documenta en docs/MIGRATIONS_PENDING.md (arriba del todo):"
echo "   ## <TICKET> · <tabla.columna> — ✅ APLICADO en prod ($(date +%Y-%m-%d))"
echo "   Incluye: el SQL del preview, host-check, el GO del fundador y la verificación vacía."
